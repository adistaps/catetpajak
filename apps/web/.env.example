# Salin file ini menjadi apps/web/.env lalu isi. JANGAN di-commit (sudah ada di .gitignore).
# Dibaca Node saat start (--env-file-if-exists=.env).

# ---------- wajib ----------
# Alamat PocketBase dari sisi server web (di VPS: lokal saja, port 8090 tidak dibuka ke publik)
POCKETBASE_URL=http://127.0.0.1:8090
# Harus SAMA dengan PB_SUPERUSER_* yang dipakai proses PocketBase
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# Domain publik tanpa https://, dipakai membuat URL file untuk fitur AI dan verifikasi bukti bayar
WEBSITE_DOMAIN=catetpajak.com

# Secret penandatangan tautan bayar invoice publik (buat dengan: npm run secrets:generate). Minimal 32 karakter.
# Mengganti nilai ini membatalkan semua tautan bayar yang sudah dikirim.
INVOICE_PAY_SECRET=

# ---------- notifikasi push (buat dengan: node scripts/gen-secrets.mjs) ----------
VAPID_SUBJECT=mailto:info@catetpajak.com
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- opsional, hanya jika dipakai ----------
# Langganan memakai TRANSFER MANUAL (keputusan klien). Hostinger Ecommerce TIDAK dipakai:
# biarkan seluruh blok ECOMMERCE_* kosong.
ECOMMERCE_API_URL=
ECOMMERCE_STORE_ID=
ECOMMERCE_API_KEY=
ECOMMERCE_META_PIXEL_ID=
ECOMMERCE_GA_ID=

# Pencairan gaji via Neo Bank (butuh akses dari klien)
NEO_BANK_BASE_URL=
NEO_BANK_CLIENT_ID=
NEO_BANK_API_KEY=

# Hanya tersedia di platform Hostinger (AI bawaan dan verifikasi bukti bayar otomatis).
# Di server sendiri biarkan kosong: fitur terkait tidak aktif sampai diganti layanan lain.
PROXY_ENTRANCE_ID=

# Bind server web. Di VPS pakai 127.0.0.1 karena Nginx CloudPanel yang membuka ke publik.
HOST=127.0.0.1
PORT=3000
