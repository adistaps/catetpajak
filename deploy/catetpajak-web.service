# /etc/systemd/system/catetpajak-web.service
[Unit]
Description=Catet Pajak web (React Router + Express)
After=network.target pocketbase.service
Wants=pocketbase.service

[Service]
User=catetpajak
Group=catetpajak
WorkingDirectory=/home/catetpajak/htdocs/catetpajak.com/apps/web
ExecStart=/home/catetpajak/htdocs/catetpajak.com/deploy/run-web.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
